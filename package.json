{
  "name": "tabi-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "lint": "pnpm lint:directives && oxlint --deny-warnings .",
    "lint:fix": "pnpm lint:directives && oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm storybook:generate && tsc --noEmit",
    "test": "vitest run",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:deps",
    "hooks:install": "lefthook install",
    "lint:directives": "node scripts/check-lint-directives.ts",
    "commitlint": "commitlint --strict",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check:transforms": "vitest run scripts/build/transforms.test.ts",
    "export:android": "expo export --platform android --max-workers 2",
    "export:ios": "expo export --platform ios --max-workers 2",
    "storybook:native": "cross-env STORYBOOK_ENABLED=true STORYBOOK_SERVER=false expo start --dev-client",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "check:native-bundles": "pnpm storybook:generate && node scripts/check-native-bundles.ts",
    "check:android-ui": "node scripts/check-android-ui.ts",
    "map:generate": "node scripts/build/japan-map.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.17",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/flash-list": "2.3.2",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-file-system": "58.0.13",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-sqlite": "58.0.15",
    "expo-system-ui": "58.0.7",
    "lucide-react-native": "1.70.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@react-native/metro-config": "0.88.1",
    "@storybook/react-native": "10.7.1",
    "@storybook/react-native-ui-lite": "10.7.1",
    "@storybook/react-native-web-vite": "10.6.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "58.0.24",
    "cross-env": "10.1.0",
    "lefthook": "2.2.2",
    "mapshaper": "0.7.101",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "storybook": "10.6.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-rnw": "0.0.11",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.18.x",
    "pnpm": "10.24.x"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "patchedDependencies": {
      "expo-image-manipulator@58.0.16": "patches/expo-image-manipulator@58.0.16.patch"
    }
  }
}
