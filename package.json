{
  "name": "tabi-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm lint:directives && oxlint --deny-warnings .",
    "lint:fix": "pnpm lint:directives && oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:deps",
    "hooks:install": "lefthook install",
    "lint:directives": "node scripts/check-lint-directives.ts",
    "commitlint": "commitlint --strict"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.18.x",
    "pnpm": "10.24.x"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
