{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "react"],
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/lint/**/*.ts",
    "scripts/check-lint-directives.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "vitest.config.ts",
    "commitlint.config.ts",
    "scripts/commit/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "app.config.ts",
    "nativewind-env.d.ts",
    "scripts/build/**/*.ts",
    "scripts/fixtures/**/*.ts"
  ],
  "extends": "expo/tsconfig.base"
}
