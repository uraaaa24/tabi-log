{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/lint/**/*.ts",
    "scripts/check-lint-directives.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "vitest.config.ts"
  ]
}
